# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database host (localhost for local development, domain/IP for production)
DB_HOST=localhost

# Database port (default: 3306 for MySQL/MariaDB)
DB_PORT=3306

# Database name
DB_NAME=astrotarot_db

# Database user
DB_USER=astrotarot_user

# Database password (IMPORTANT: Change this to a secure password in production)
DB_PASSWORD=your_secure_password_here

# ============================================================================
# SMTP CONFIGURATION (Email)
# ============================================================================
# SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (email address)
SMTP_USERNAME=your_email@gmail.com

# SMTP password (IMPORTANT: Never commit actual passwords to version control)
SMTP_PASSWORD=your_app_specific_password

# SMTP encryption type (tls or ssl)
SMTP_ENCRYPTION=tls

# From email address (sender address in emails)
SMTP_FROM_EMAIL=your_email@gmail.com

# From name (sender name in emails)
SMTP_FROM_NAME=Astro Tarot

# BCC email address (optional - will receive a copy of all sent emails)
SMTP_BCC_EMAIL=your_email@gmail.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Set to 'production' or 'development'
APP_ENV=development

# Enable/disable debug mode
DEBUG=true
